# JARVIS secrets — copy to .env and fill in. Never commit .env.

# Required (Phase 1) — the reasoning core
ANTHROPIC_API_KEY=

# Voice (Phase 2) — optional, falls back to local/offline providers
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# Web research (Phase 4) — optional
TAVILY_API_KEY=

# Semantic memory (Phase 5) — optional. Without this, JARVIS uses keyword
# recall, or local sentence-transformers if you install the 'memory' extra.
VOYAGE_API_KEY=

# Spotify (Phase 6) — optional
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
